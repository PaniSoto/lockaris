generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(uuid())
  name        String?
  email       String       @unique
  password    String
  createdAt   DateTime     @default(now())
  credentials Credential[]
}

enum CredentialType {
  LOGIN
  CARD
  NOTE
}

model Credential {
  id                String         @id @default(uuid())
  type              CredentialType @default(LOGIN)
  serviceName       String         
  notes             String?        // Notas visibles (no encriptadas)
  username          String?        // Opcional porque una Nota no tiene usuario
  url               String?
  encryptedPassword String?        // Opcional porque una Nota no tiene password
  cardholderName    String?        // Nombre del titular
  encryptedCardNumber String?      // El número largo (Encriptado)
  encryptedCvv      String?        // El código de seguridad (Encriptado)
  expiryDate        String?        // MM/YY
  iv                String         // Vector de inicialización principal
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}
