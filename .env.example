# --- CONFIGURACIÓN DE BASE DE DATOS ---
# URL de conexión a PostgreSQL (Neon)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://usuario:contraseña@host:5432/nombre_db?sslmode=require"

# --- SEGURIDAD DE NEXTAUTH ---
# Para generar un valor válido, ejecuta en tu terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="copiar_y_pegar_resultado_del_comando_aqui"

# --- CLAVE MAESTRA DE CIFRADO ---
# Ejecuta este comando para generar una clave válida:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ENCRYPTION_KEY="copiar_y_pegar_resultado_del_comando_aqui"

# --- FIRMA DE TOKENS JWT ---
# Clave para firmar los JSON Web Tokens.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="copiar_y_pegar_resultado_del_comando_aqui"